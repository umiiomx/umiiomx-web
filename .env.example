# Variables privadas: nunca subir .env.local a GitHub ni pegarlas en el chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL HTTPS pública real del sitio (sin barra final).
STORE_URL=
# Definir tarifa de envío en MXN antes de activar ventas. 0 significa envío gratis.
SHIPPING_MXN=
MERCADOPAGO_TEST_MODE=true
# Mantener false hasta completar pruebas y definir envío y políticas de la tienda.
ENABLE_ONLINE_PAYMENTS=false
